      "id": "2d489801-1c4b-49e6-b29d-cf2d0a9473d0",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    id,\n    student,\n    subject,\n    task,\n    deadline,\n    priority,\n    days_remaining,\n    urgency,\n    status\nFROM tasks\nWHERE status = 'pending'\n  AND days_remaining <= 3\nORDER BY days_remaining ASC;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        224,
        0
      ],
      "id": "cf0c6d77-0efc-4572-b93c-617ff46826aa",
      "name": "Execute a SQL query",
      "credentials": {
        "mySql": {
          "id": "mN4GsCqluHRoxvkj",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const tasks = $input.all().map(item => item.json);\n\nreturn tasks.map(task => {\n  let reminderMessage;\n\n  if (Number(task.days_remaining) < 0) {\n    reminderMessage =\n      `⚠️ OVERDUE: ${task.subject} — ${task.task} was due on ${task.deadline}.`;\n  } else if (Number(task.days_remaining) === 0) {\n    reminderMessage =\n      `🚨 DUE TODAY: ${task.subject} — ${task.task}.`;\n  } else if (Number(task.days_remaining) === 1) {\n    reminderMessage =\n      `⏰ DUE TOMORROW: ${task.subject} — ${task.task}.`;\n  } else {\n    reminderMessage =\n      `📚 Deadline Reminder: ${task.subject} — ${task.task} is due in ${task.days_remaining} days (${task.deadline}).`;\n  }\n\n  return {\n    json: {\n      ...task,\n      reminderMessage\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "915c7e71-52fd-4113-ad84-655a6f20afb6",
      "name": "Prepare Deadline Reminders"
    },
