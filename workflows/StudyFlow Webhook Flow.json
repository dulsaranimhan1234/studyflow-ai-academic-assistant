        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are StudyFlow, an AI academic assistant. Analyze this student's academic task and give a practical recommendation.\\n\\nStudent: {{ $json.student }}\\nSubject: {{ $json.subject }}\\nTask: {{ $json.task }}\\nDeadline: {{ $json.deadline }}\\nDays remaining: {{ $json.daysRemaining }}\\nUrgency: {{ $json.urgency }}\\nPriority: {{ $json.priority }}\\n\\nGive a concise recommendation explaining what the student should do next. Consider the deadline, urgency, and priority. Do not mention or output any template variables such as {{ $json.student }}. Use the actual values provided.\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ],
