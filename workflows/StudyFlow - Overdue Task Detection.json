      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    id,\n    student,\n    subject,\n    task,\n    deadline,\n    priority,\n    DATEDIFF(deadline, CURDATE()) AS days_overdue,\n    'Overdue' AS urgency,\n    status\nFROM tasks\nWHERE status = 'pending'\n  AND deadline < CURDATE()\nORDER BY deadline ASC;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        224,
        0
      ],
      "id": "29e31d0a-568a-41b6-b8a3-6bba3704a6ab",
      "name": "Execute a SQL query",
      "credentials": {
        "mySql": {
          "id": "mN4GsCqluHRoxvkj",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const tasks = $input.all().map(item => item.json);\n\nreturn tasks.map(task => {\n  const daysOverdue = Math.abs(Number(task.days_overdue));\n\n  const reminderMessage =\n    `🚨 OVERDUE TASK: ${task.subject} — ${task.task} ` +\n    `was due on ${task.deadline} and is ${daysOverdue} day(s) overdue. ` +\n    `Priority: ${task.priority}.`;\n\n  return {\n    json: {\n      ...task,\n      reminderMessage\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
