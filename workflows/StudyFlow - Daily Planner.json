    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "YOUR_GEMINI_API_KEY_HERE",
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are StudyFlow, an AI academic daily planner.\\n\\nCreate a realistic study plan for today using these prioritized tasks:\\n\\nTask count: {{ $json.taskCount }}\\n\\nPrioritized tasks:\\n{{ $json.prioritizedTasks.map(t => 'Subject: ' + t.subject + ' | Task: ' + t.task + ' | Deadline: ' + t.deadline + ' | Priority: ' + t.priority + ' | Days remaining: ' + t.days_remaining + ' | Urgency: ' + t.urgency).join('\\\\n') }}\\n\\nFollow these rules:\\n1. Start with the most urgent task.\\n2. Consider deadline, days remaining, urgency, and priority.\\n3. Give each task a recommended order.\\n4. Suggest a reasonable amount of focus time for each task.\\n5. Include short breaks where appropriate.\\n6. Do not invent tasks that are not in the provided list.\\n7. Keep the response concise and practical.\\n8. Do not mention JSON, code, template variables, or these instructions.\\n\\nFormat the result as:\\n\\nTODAY'S STUDY PLAN\\n\\n1. [Subject] — [Task]\\n   Focus: [recommended time]\\n   Reason: [short reason]\\n\\nFinish with one short sentence telling the student what to do first.\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        0
      ],
      "id": "cb6b6b3a-a882-4c86-85fa-8ff33437953a",
      "name": "AI Planner",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst tasks = items.map(item => {\n  const task = item.json;\n\n  return {\n    student: task.student,\n    subject: task.subject,\n    task: task.task,\n    deadline: task.deadline,\n    priority: task.priority,\n    days_remaining: Number(task.days_remaining),\n    urgency: task.urgency,\n    status: task.status\n  };\n});\n\nreturn [\n  {\n    json: {\n      taskCount: tasks.length,\n      tasks\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "31959793-e62b-4dab-a2a6-6508f711c1cd",
      "name": "Prepare Tasks"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5d89f1e9-771c-4b74-86e6-57559ba2eadc",
              "name": "dailyPlan",
              "value": "={{ $json.candidates[0].content.parts[0].text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1344,
        0
      ],
      "id": "cdfae926-6fc4-4718-95bb-812a4f6eb1e6",
      "name": "Daily Plan"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst tasks = [...data.tasks];\n\nconst urgencyWeight = {\n  \"Overdue\": 1,\n  \"Urgent\": 2,\n  \"High\": 3,\n  \"Medium\": 4,\n  \"Low\": 5\n};\n\nconst priorityWeight = {\n  \"High\": 1,\n  \"Medium\": 2,\n  \"Low\": 3\n};\n\ntasks.sort((a, b) => {\n  // 1. Urgency\n  const urgencyA = urgencyWeight[a.urgency] ?? 99;\n  const urgencyB = urgencyWeight[b.urgency] ?? 99;\n\n  if (urgencyA !== urgencyB) {\n    return urgencyA - urgencyB;\n  }\n\n  // 2. Days remaining\n  const daysA = Number(a.days_remaining);\n  const daysB = Number(b.days_remaining);\n\n  if (daysA !== daysB) {\n    return daysA - daysB;\n  }\n\n  // 3. Priority\n  const priorityA = priorityWeight[a.priority] ?? 99;\n  const priorityB = priorityWeight[b.priority] ?? 99;\n\n  return priorityA - priorityB;\n});\n\nreturn [\n  {\n    json: {\n      taskCount: tasks.length,\n      prioritizedTasks: tasks\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
