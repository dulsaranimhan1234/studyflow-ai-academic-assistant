      ],
      "id": "cdfae926-6fc4-4718-95bb-812a4f6eb1e6",
      "name": "Daily Plan"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst tasks = [...data.tasks];\n\nconst urgencyWeight = {\n  \"Overdue\": 1,\n  \"Urgent\": 2,\n  \"High\": 3,\n  \"Medium\": 4,\n  \"Low\": 5\n};\n\nconst priorityWeight = {\n  \"High\": 1,\n  \"Medium\": 2,\n  \"Low\": 3\n};\n\ntasks.sort((a, b) => {\n  // 1. Urgency first\n  const urgencyA = urgencyWeight[a.urgency] ?? 99;\n  const urgencyB = urgencyWeight[b.urgency] ?? 99;\n\n  if (urgencyA !== urgencyB) {\n    return urgencyA - urgencyB;\n  }\n\n  // 2. Earlier deadline first\n  const daysA = Number(a.days_remaining);\n  const daysB = Number(b.days_remaining);\n\n  if (daysA !== daysB) {\n    return daysA - daysB;\n  }\n\n  // 3. Higher priority first\n  const priorityA = priorityWeight[a.priority] ?? 99;\n  const priorityB = priorityWeight[b.priority] ?? 99;\n\n  return priorityA - priorityB;\n});\n\nreturn [\n  {\n    json: {\n      taskCount: tasks.length,\n      prioritizedTasks: tasks\n    }\n  }\n];"
      },
