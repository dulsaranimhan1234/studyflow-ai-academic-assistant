        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are StudyFlow, an AI academic daily planner.\\n\\nCreate a practical study plan for today using these prioritized tasks:\\n\\n{{ JSON.stringify($json.prioritizedTasks) }}\\n\\nRules:\\n- Focus first on the most urgent tasks.\\n- Consider days remaining and priority.\\n- Give the student a clear order of what to work on.\\n- Keep the plan concise and practical.\\n- Do not mention JSON, code, or template variables.\\n- Do not invent tasks that are not provided.\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        0
      ],
      "id": "cb6b6b3a-a882-4c86-85fa-8ff33437953a",
      "name": "AI Planner"
    },
    {
      "parameters": {
        "jsCode": "const tasks = $input.all().map(item => item.json);\n\nreturn [\n  {\n    json: {\n      taskCount: tasks.length,\n      tasks: tasks\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
