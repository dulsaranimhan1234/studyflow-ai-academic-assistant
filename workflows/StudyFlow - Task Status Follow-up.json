      "id": "2ca51f90-df05-4412-976d-a21752d9c139",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    id,\n    student,\n    subject,\n    task,\n    deadline,\n    priority,\n    DATEDIFF(deadline, CURDATE()) AS days_remaining,\n    DATEDIFF(CURDATE(), DATE(created_at)) AS days_pending,\n    status,\n    created_at\nFROM tasks\nWHERE status = 'pending'\n  AND DATEDIFF(CURDATE(), DATE(created_at)) >= 3\nORDER BY created_at ASC;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        224,
        0
      ],
      "id": "dde3cbf9-d08d-4aa8-b316-0109de9e54bc",
      "name": "Execute a SQL query",
      "credentials": {
        "mySql": {
          "id": "mN4GsCqluHRoxvkj",
          "name": "MySQL account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const tasks = $input.all().map(item => item.json);\n\nreturn tasks.map(task => {\n  const daysPending = Number(task.days_pending);\n\n  let followUpMessage;\n\n  if (daysPending >= 7) {\n    followUpMessage =\n      `🔴 This task has remained pending for ${daysPending} days. ` +\n      `Please review its progress and update its status.`;\n  } else {\n    followUpMessage =\n      `🟡 This task has remained pending for ${daysPending} days. ` +\n      `Please check your progress and update its status if necessary.`;\n  }\n\n  return {\n    json: {\n      ...task,\n      followUpMessage\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "1f9ee9a1-21b8-4dd2-8a69-5540302853d0",
      "name": "Prepare Follow-up Alerts"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "602c9b30-627a-42d9-89e6-dba8d842b5c2",
              "leftValue": "={{ $json.days_pending }}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
