      "id": "a5919a33-9e12-4682-921d-70e583e99eea",
      "name": "Prepare User Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "YOUR_GEMINI_API_KEY_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are StudyFlow, an AI academic task interpreter.\\n\\nConvert the student's natural language request into structured academic task information.\\n\\nToday's date: {{ $now.format('yyyy-MM-dd') }}\\n\\nStudent message:\\n{{ $json.userMessage }}\\n\\nExtract these fields:\\n- subject\\n- task\\n- deadline\\n- priority\\n\\nRules:\\n1. Return ONLY valid JSON.\\n2. Do not use Markdown.\\n3. Do not add explanations.\\n4. If a field is not provided, use null.\\n5. Use the deadline format YYYY-MM-DD when a specific date is provided.\\n6. Priority must be High, Medium, or Low when provided.\\n7. When the student gives a date without a year, assume the next occurrence of that date relative to today's date.\\n8. Never return a date in the past when a future occurrence is possible.\\n9. If the student says a relative date such as tomorrow, next Monday, or next week, calculate the date relative to today's date.\\n\\nReturn exactly this structure:\\n{\\n  \\\"subject\\\": \\\"...\\\",\\n  \\\"task\\\": \\\"...\\\",\\n  \\\"deadline\\\": \\\"YYYY-MM-DD\\\",\\n  \\\"priority\\\": \\\"High\\\"\\n}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "id": "d52105fd-77a1-4dc3-aefe-ea05853be76d",
      "name": "AI Interpreter",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst rawText = response.candidates[0].content.parts[0].text;\n\nconst cleanedText = rawText\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet taskData;\n\ntry {\n  taskData = JSON.parse(cleanedText);\n} catch (error) {\n  throw new Error(\"AI response is not valid JSON: \" + cleanedText);\n}\n\nreturn [\n  {\n    json: {\n      student: $('Webhook').first().json.body.student,\n      subject: taskData.subject,\n      task: taskData.task,\n      deadline: taskData.deadline,\n      priority: taskData.priority\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "216cb118-fd97-4fc1-9336-ffe8f9a381f9",
      "name": "Parse AI Task"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst deadline = new Date(item.deadline);\nconst today = new Date();\n\ntoday.setHours(0, 0, 0, 0);\ndeadline.setHours(0, 0, 0, 0);\n\nconst differenceMs = deadline - today;\n\nconst daysRemaining = Math.ceil(\n  differenceMs / (1000 * 60 * 60 * 24)\n);\n\nlet urgency;\n\nif (daysRemaining < 0) {\n  urgency = \"Overdue\";\n} else if (daysRemaining <= 1) {\n  urgency = \"Urgent\";\n} else if (daysRemaining <= 3) {\n  urgency = \"High\";\n} else if (daysRemaining <= 7) {\n  urgency = \"Medium\";\n} else {\n  urgency = \"Low\";\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n      daysRemaining,\n      urgency,\n      status: \"pending\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        -192
      ],
      "id": "b75fd27f-b7eb-4a13-adb2-a06ef78e6c1d",
      "name": "Deadline Intelligence"
    },
